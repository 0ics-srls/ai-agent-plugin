; The lint pack for GDScript (Godot 4.7): the warnings of the engine that find a defect are errors (2) —
; a value used before it is given, a coroutine nobody awaits, a division that truncates, a type the
; engine cannot check, a result dropped (in GDScript an error is a return value) — each chosen one by
; one for that. The others are off (0): unused names, style. They find no defect, and on code that
; exists they only make it be rewritten.
; A warning joins or leaves the errors by the project owner's decision, with its reason.
; inferred_declaration is off: `:=` is the typed form when the type is evident from the right side; a
; declaration without a type (untyped_declaration) and `:=` on a Variant (inference_on_variant) are errors.
; The code under addons/ is not the project's: directory_rules keeps the engine default that
; silences it there. Merged into the project.godot the editor creates; a project that already
; has one gets the [debug] section merged, asking first.
config_version=5

[debug]

gdscript/warnings/enable=true
gdscript/warnings/directory_rules={ "res://addons": 0 }
gdscript/warnings/unassigned_variable=2
gdscript/warnings/unassigned_variable_op_assign=2
gdscript/warnings/unreachable_code=2
gdscript/warnings/unreachable_pattern=2
gdscript/warnings/standalone_expression=2
gdscript/warnings/incompatible_ternary=2
gdscript/warnings/missing_await=2
gdscript/warnings/integer_division=2
gdscript/warnings/get_node_default_without_onready=2
gdscript/warnings/onready_with_export=2
gdscript/warnings/standalone_ternary=2
gdscript/warnings/assert_always_true=2
gdscript/warnings/assert_always_false=2
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/int_as_enum_without_match=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inference_on_variant=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/confusable_local_declaration=2
gdscript/warnings/confusable_local_usage=2
gdscript/warnings/confusable_capture_reassignment=2
gdscript/warnings/confusable_temporary_modification=2
gdscript/warnings/native_method_override=2
gdscript/warnings/property_used_as_function=2
gdscript/warnings/constant_used_as_function=2
gdscript/warnings/function_used_as_property=2
gdscript/warnings/return_value_discarded=2
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_void_return=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_signal=0
gdscript/warnings/enum_variable_without_default=0
gdscript/warnings/missing_tool=0
gdscript/warnings/deprecated_keyword=0
gdscript/warnings/confusable_identifier=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/static_called_on_instance=0
gdscript/warnings/redundant_static_unload=0
gdscript/warnings/redundant_await=0
gdscript/warnings/empty_file=0
gdscript/warnings/renamed_in_godot_4_hint=true
